  "lessons": [
    {
      "id": "order-isotropy",
      "module": "order",
      "title": "从序参量方向到保留操作与畴",
      "summary": "把指定状态的对称性、能量函数的对称性和等价状态轨道分开计算。",
      "preset": "order-cubic-axis",
      "references": [
        "isodistort"
      ],
      "sections": [
        {
          "title": "先声明表示",
          "text": "本实验中序参量是C₄ᵥ的二维极向量，或O_h的三维极向量。点群矩阵作用于η；O_h极向量的反演为−I。氧八面体转动是轴向量，不能直接套用此反演规则。",
          "formula": "η → D(g)η"
        },
        {
          "title": "状态的稳定子群",
          "text": "逐个操作检验D(g)η=η，保留下来的操作构成稳定子群。零向量保留母群；非零方向可以降对称。计算采用1e−9的数值比较阈值，实际矩阵以精确整数生成。",
          "formula": "H_η = {g ∈ G : D(g)η = η}"
        },
        {
          "title": "轨道不等于操作列表",
          "text": "不同操作可能把η送到同一个方向，所以需要去重。O_h沿坐标轴产生六个方向，沿体对角线产生八个；它们来自不同稳定子群。仅指定方向尚未证明自由能在此达到极小。",
          "formula": "|Gη| = |G| / |H_η|"
        },
        {
          "title": "材料联系与边界",
          "text": "BaTiO₃极化的轴向或对角线方向可作为图像背景；本工具没有自动构造真实原子位移、空间群子群、平移畴或实验相图。请到结构畸变和相变模块研究给定模式与能量。"
        }
      ]
    },
    {
      "id": "order-invariants",
      "module": "order",
      "title": "逐个生成元推导允许的自由能项",
      "summary": "从单项式群平均得到独立不变量，再用实际系数画能面截线。",
      "preset": "order-axis",
      "references": [
        "isotropy"
      ],
      "sections": [
        {
          "title": "从一个单项式开始",
          "text": "对η_x²等单项式施加所有群操作并平均。被符号相消的单项式不产生不变量；等价单项式给出重复的轨道和。保留独立轨道和后可选最小整数系数归一。",
          "formula": "P_G f(η) = (1/|G|) Σ_g f(D(g)η)"
        },
        {
          "title": "约束有可追溯来源",
          "text": "点击某条系数关系，可看到生成元矩阵、变换前后的指数和符号。镜面使η_xη_y变号，要求它的系数为零；四重旋转则要求η_x²与η_y²的系数相同。",
          "formula": "F(D(g)η) = F(η)"
        },
        {
          "title": "允许形式不决定系数",
          "text": "C₄ᵥ在二、四、六阶分别有1、2、2个独立不变量；O_h分别有1、2、3个。系数是教学输入，对称性不决定正负或大小。二阶连续各向同性可以只是低阶截断的偶然性质。",
          "formula": "F = a₂ I₂ + b₄ I₄a + c₄ I₄b + d₆ I₆a + e₆ I₆b + f₆ I₆c"
        },
        {
          "title": "径向极小与完整稳定",
          "text": "沿所选方向解一元多项式的全部实驻点；它们不等于多维自由能的全部极小。角向扫描固定xy半径和z分量；曲线平坦或局部极小不能单独证明热力学相。最高阶有界性使用充分条件，并明确未通过时的限制。"
        }
      ]
    },
    {
      "id": "order-field-convention",
      "module": "order",
      "title": "显式破缺、畴能量与坐标约定",
      "summary": "区分改变外场这个物理操作和被动改变坐标这个记号操作。",
      "preset": "order-convention",
      "references": [
        "isodistort",
        "isotropy"
      ],
      "sections": [
        {
          "title": "外场不是自动保留母群",
          "text": "加入固定实验室x方向的线性场后，只保留同时使场不变的操作。母群轨道仍用于比较，但其不同方向可出现能量劈裂。",
          "formula": "F_h(η) = F₀(η) − h·η"
        },
        {
          "title": "三个群的区别",
          "text": "分别观察母群G、使外场不变的能量对称群G_h，以及使场与状态都不变的交集。不能只根据某个状态的稳定子群宣布整个Hamiltonian已经自发破缺。",
          "formula": "H_{η,h} = H_η ∩ G_h"
        },
        {
          "title": "被动坐标变换",
          "text": "Q的列是新坐标轴在旧坐标中的分量。η、场、群矩阵和能量表达式必须同时变换；仅旋转序参量但不改能量各向异性通常是改变物理状态。",
          "formula": "η′ = Qᵀη；D′ = Qᵀ D Q；F′(η′) = F(Qη′)"
        },
        {
          "title": "验证而非逐项对号",
          "text": "比较两种坐标下的能量、稳定子群阶数和操作作用的协变残差。矩阵元素改变是正常现象；能量和轨道计数才是此处需要保持的结果。"
        }
      ]
    }
  ],
