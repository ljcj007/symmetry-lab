  "sources": [
    {
      "id": "bcs-sam",
      "title": "Bilbao：SAM 官方帮助",
      "url": "https://cryst.ehu.es/rep/sam_help.html",
      "note": "机械表示、Γ 点对称适配模式和 IR/Raman 活性分类的方法依据。本文的算例、题目和推导为原创。"
    },
    {
      "id": "iucr-tensors",
      "title": "IUCr：An Introduction to Crystal Physics，Ervin Hartmann",
      "url": "https://www.iucr.org/__data/assets/pdf_file/0003/14790/18.pdf",
      "note": "§2–4 区分张量变换、本征指标对称性与晶体对称性；平衡响应和输运响应的适用条件不同。"
    },
    {
      "id": "bcs-mtensor",
      "title": "Bilbao：MTENSOR 官方帮助",
      "url": "https://www.cryst.ehu.es/cryst/mtensor_help.html",
      "note": "磁点群约束张量的背景资料；本课堂独立用极性、轴性和时间反演奇偶推导静态线性磁电响应。"
    },
    {
      "id": "iucr-spin-tensors",
      "title": "Etxebarria 等：Crystal tensor properties of magnetic materials with and without spin–orbit coupling (2025)",
      "url": "https://journals.iucr.org/a/issues/2025/04/00/cam5007/",
      "note": "用于说明磁点群与忽略自旋轨道耦合时的自旋点群约束具有不同适用范围。这里的练习只指定磁点群，不替真实磁性材料判定磁序。"
    },
    {
      "id": "aflow-silicon",
      "title": "AFLOW：Diamond (A4) 结构原型",
      "url": "https://aflow.org/p/A_cF8_227_a-001/",
      "note": "核验 Si 金刚石结构、No.227 和两原子原胞。"
    },
    {
      "id": "aflow-gaas",
      "title": "AFLOW：Zincblende (B3) 结构原型",
      "url": "https://aflow.org/p/AB_cF8_216_a_c-001/",
      "note": "核验 GaAs 闪锌矿结构、No.216 和不同化学占位造成的反演缺失。"
    },
    {
      "id": "aflow-nacl",
      "title": "AFLOW：Rock Salt/Halite (NaCl, B1) 结构原型",
      "url": "https://aflow.org/p/AB_cF8_225_a_b-001/",
      "note": "核验 NaCl 岩盐结构、No.225 与两套 fcc 子晶格。"
    }
  ],
