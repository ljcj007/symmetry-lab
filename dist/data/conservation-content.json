  "lessons": [
    {
      "id": "conservation-generators",
      "module": "conservation",
      "title": "从连续旋转到完整算符守恒",
      "summary": "用生成元与对易子连接SU(2)、U(1)、离散对称和实际动力学。",
      "preset": "conservation-su2",
      "references": [
        "tong",
        "qutip"
      ],
      "sections": [
        {
          "title": "Noether主线与本实验的范围",
          "text": "连续作用量对称性联系守恒量；本实验使用有限量子系统的对应判据。对不显含时间的Hermitian算符Q，所有初态都守恒等价于完整Hamiltonian与Q对易。有限两自旋模型不能验证热力学极限自发破缺。",
          "formula": "U(θ)=exp(−iθQ)；d⟨Q⟩/dt=i⟨[H/ℏ,Q]⟩"
        },
        {
          "title": "从SU(2)到U(1)",
          "text": "全局旋转生成元是两个自旋之和。各向同性交换与三个分量都对易。XXZ保留绕z连续旋转，但一般不保留绕x和y连续旋转。均匀纵场也保留Sz。仅有S²守恒并不保证SU(2)：本双自旋1/2的无梯度XYZ模型也可保留S²，却不保留三个旋转生成元。",
          "formula": "S_α=S_{Aα}+S_{Bα}；H/ℏ=Σ_α J_α S_{Aα}S_{Bα}+h_x S_x+h_z S_z"
        },
        {
          "title": "逐项不守恒可以相消",
          "text": "各向同性交换的y项、z项分别与Sx不对易，但两者的矩阵贡献相消。只把逐项范数相加会错误地宣布破缺；点击约束来源应同时查看矩阵和完整残差。",
          "formula": "[H_y+H_z,S_x]=[H_y,S_x]+[H_z,S_x]"
        },
        {
          "title": "离散旋转不是同一个条件",
          "text": "无场XYZ可以保留π旋转，却不保留由相同轴生成的任意角旋转。有限角度的对易关系不能直接替代生成元的对易关系；坐标轴均不守恒也不排除某个斜轴上的额外对称。",
          "formula": "[H,exp(−iπS_z)]=0 不推出 [H,S_z]=0"
        }
      ]
    },
    {
      "id": "conservation-open",
      "module": "conservation",
      "title": "Hamiltonian对称与耗散系统守恒",
      "summary": "区分模型的算符恒等式、一个初态的平坦轨迹和浴通道的影响。",
      "preset": "conservation-bath",
      "references": [
        "lindblad",
        "qutip"
      ],
      "sections": [
        {
          "title": "检查整个生成元",
          "text": "Lindblad主方程把Hamiltonian演化和每个耗散通道一起定义。对时间无关Q，d⟨Q⟩/dt=⟨L†Q⟩；若要对所有初态守恒，须使完整算符L†Q为零。",
          "formula": "L†Q=i[H/ℏ,Q]+Σ_c(C_c†QC_c−{C_c†C_c,Q}/2)"
        },
        {
          "title": "纯退相干会保留什么",
          "text": "本实验各站点的z通道使横向总自旋衰减，对总Sz的耗散贡献为零。若Hamiltonian本身还与Sz对易，则Sz保持守恒。加入↑→↓弛豫后，Sz通常不再守恒。",
          "formula": "C_φ=√(γ_φ/2)σ_z；D†S_x=−γ_φ S_x"
        },
        {
          "title": "平坦曲线并不能证明对称性",
          "text": "闭系统的最大混合态I/d在任何时间无关Hamiltonian下不变。即使[H,Sz]不为零，它的⟨Sz⟩也一直为零。应把轨迹与算符残差并排比较，再改变初态。",
          "formula": "[H,I/d]=0"
        },
        {
          "title": "数值轨迹与实际物理模型",
          "text": "计算使用常量生成元矩阵指数，并检查迹、厄米性与半正定性。采样过稀可能漏掉振荡，但不应该改变同一时刻的物理态；本地浴并不自动满足真实材料的详细平衡。"
        }
      ]
    },
    {
      "id": "conservation-protection",
      "module": "conservation",
      "title": "时间反演保护与一致换基",
      "summary": "用物理反幺正算符判断简并来源，再验证换基后的不变量。",
      "preset": "conservation-kramers",
      "references": [
        "kramers",
        "qutip"
      ],
      "sections": [
        {
          "title": "先指定物理时间反演",
          "text": "单自旋1/2的物理时间反演可写成T=−iσ_yK，平方为−I。两个可区分自旋的总时间反演作用于两者，平方为+I；不能把其中一个自旋的Kramers条件直接套在整体。",
          "formula": "T=U_T K；T²=U_T U_T*"
        },
        {
          "title": "简并需要保护条件",
          "text": "对于本实验没有动量标签的有限Hamiltonian，T²=−I且T与H对易保证Kramers配对。单自旋外场破坏T，扫描εSz可观察能级分裂。双自旋T²=+I本身没有这个结论。",
          "formula": "U_T H* U_T†=H"
        },
        {
          "title": "双自旋多重态的其他来源",
          "text": "各向同性交换的三重态简并可由SU(2)解释；它不是T²=+I带来的Kramers简并。对于其他数值重合，程序只报告能级重数，不把重合一律命名为偶然或拓扑保护。"
        },
        {
          "title": "换基必须同时改变所有对象",
          "text": "对新基矢=旧基矢×U，H、Q、ρ及每个C均变为U†AU，反幺正矩阵变为U†U_T U*。计算比较能级、期望值、演化态和伴随作用的协变性；被动换基不同于实际转动样品而固定外场。",
          "formula": "A′=U†AU；ρ′=U†ρU；U_T′=U†U_T U*"
        }
      ]
    }
  ],
  "exercises": [
    {
      "id": "conservation-generators-exercise",
      "module": "conservation",
      "lesson": "conservation-generators",
      "title": "逐项检查SU(2)到U(1)的破缺",
      "prompt": "依次比较各向同性、XXZ和XYZ预设，保留系数单位与S=σ/2约定。",
      "steps": [
        {
          "prompt": "对于所有初态的闭系统Q守恒，应检查哪个量？",
          "hint": "Q不显含时间，检查算符恒等式。",
          "choices": [
            "一条曲线是否平坦",
            "完整[H,Q]是否为零",
            "Q的迹是否为零"
          ],
          "answer": 1,
          "explanation": "完整对易子为零才给出对所有初态的保证。"
        },
        {
          "prompt": "各向同性交换的每一项都必须与Sx单独对易吗？",
          "hint": "矩阵相加后再计算范数。",
          "choices": [
            "必须",
            "不必，非零贡献可能相消",
            "只有初态纯时必须"
          ],
          "answer": 1,
          "explanation": "y和z交换项的贡献在Jy=Jz时相消。"
        },
        {
          "prompt": "XXZ中Jx=Jy≠Jz且无横场，哪个坐标轴生成元仍守恒？",
          "hint": "绕z旋转会混合x与y分量。",
          "choices": [
            "Sx",
            "Sy",
            "Sz"
          ],
          "answer": 2,
          "explanation": "Jx=Jy保留绕z的连续旋转。"
        },
        {
          "prompt": "XYZ保留绕z的π旋转，是否必然保留Sz？",
          "hint": "有限角度对称性弱于任意角度连续对称。",
          "choices": [
            "是",
            "否，须另查[H,Sz]",
            "只有将单位改成eV后才守恒"
          ],
          "answer": 1,
          "explanation": "离散旋转不自动给出连续生成元守恒。"
        }
      ]
    },
