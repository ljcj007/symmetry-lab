    {
      "id": "conservation-protection-exercise",
      "module": "conservation",
      "lesson": "conservation-protection",
      "title": "区分Kramers配对、SU(2)多重态与换基",
      "prompt": "比较无场单自旋、加场单自旋及各向同性双自旋。",
      "steps": [
        {
          "prompt": "单自旋1/2的物理T²是什么？",
          "hint": "T含复共轭，不能只计算U_T²并忽略K。",
          "choices": [
            "+I",
            "−I",
            "零"
          ],
          "answer": 1,
          "explanation": "T²=U_TU_T*=−I。"
        },
        {
          "prompt": "两个可区分自旋1/2整体T²是什么？",
          "hint": "总T作用于两个自旋。",
          "choices": [
            "−I",
            "+I",
            "取决于选用x还是z基底"
          ],
          "answer": 1,
          "explanation": "两个负号相乘为正，整体不由Kramers定理强制配对。"
