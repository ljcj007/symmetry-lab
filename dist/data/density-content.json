  "lessons": [
    {
      "id": "density-pure-mixed",
      "module": "density",
      "title": "叠加、混合与部分迹",
      "summary": "用相同的局部测量结果，辨认不同的整体量子态。",
      "preset": "singlet",
      "sections": [
        {
          "title": "密度矩阵保留什么信息",
          "text": "纯态写为外积，统计混合写为外积的加权和。对角元是给定基底中的测量概率，非对角元含相干；换基会改变矩阵外观，却不改变纯度。",
          "formula": "ρ=Σ_a p_a |ψ_a⟩⟨ψ_a|；Trρ=1；P=Tr(ρ²)"
        },
        {
          "title": "叠加不是经典随机选择",
          "text": "+x 纯态与 ↑、↓ 等权混合在 z 方向测量都各有一半概率；前者在 x 方向确定为正，后者仍是随机。应比较完整密度矩阵，而不只看某一组布居。",
          "formula": "ρ_{+x}=(I+σ_x)/2；ρ_{mix}=I/2"
        },
        {
          "title": "只观察 A 时要对 B 求部分迹",
          "text": "双自旋单重态是整体纯态，但任意一方的约化态是 I/2。另一方被忽略，并不表示整体曾进行经典随机混合。",
          "formula": "ρ_A=Tr_Bρ；|S⟩=(|↑↓⟩−|↓↑⟩)/√2"
        },
        {
          "title": "相同局部态不保证相同整体纠缠",
          "text": "单重态与反平行经典等权混合都有 S(ρ_A)=1 bit；两者整体纯度分别为1和1/2，负性分别为1/2和0。局部熵仅在整体纯态时直接量化这一划分的纠缠。",
          "formula": "S(ρ_A)=−Tr(ρ_A log₂ρ_A)"
        }
      ],
      "references": [
        "density-qutip-tensor",
        "density-negativity"
      ]
    },
    {
      "id": "density-lindblad",
      "module": "density",
      "title": "从 Rabi 振荡到弛豫与退相干",
      "summary": "先建立无耗散基准，再分开观察布居损失与相干损失。",
      "preset": "rabi-damped",
      "sections": [
        {
          "title": "先固定旋转角的单位",
          "text": "本实验 Ω、Δ 是 H/ℏ 的系数，单位 rad/ns；时间为 ns。共振且从 ↑ 出发时，↑ 概率在 cos²(Ωt/2) 与0之间振荡。角频率与周期频率相差2π。",
          "formula": "H/ℏ=(Ωσ_x+Δσ_z)/2；P_{↑}(t)=cos²(Ωt/2)（Δ=0，无耗散）"
        },
        {
          "title": "↑ 到 ↓ 的幅度阻尼",
          "text": "选择 C₁=√γ₁ |↓⟩⟨↑|，无驱动时 ↑ 布居以 γ₁ 衰减。通道方向固定；它不会随 detuning 符号自动翻转。",
          "formula": "C_1=√γ_1 |↓⟩⟨↑|；ρ_{↑↑}(t)=ρ_{↑↑}(0) exp(−γ_1 t)"
        },
        {
          "title": "纯退相干只破坏固定基底的相干",
          "text": "选择 C_φ=√(γ_φ/2) σ_z；没有横向驱动时，对角元不变，非对角元包络按 γ_φ 衰减。单自旋 Bloch 向量由球面缩向 z 轴。",
          "formula": "C_φ=√(γ_φ/2) σ_z；|ρ_{↑↓}(t)|=|ρ_{↑↓}(0)| exp(−γ_φ t)（γ_1=0，Ω=0）"
        },
        {
          "title": "T₁ 与 T₂ 不是两个任意独立的拟合参数",
          "text": "本通道约定给出无驱动、无交换单自旋的纵向与横向包络。存在驱动和双自旋耦合时，完整曲线未必是单一指数。",
          "formula": "1/T_1=γ_1；1/T_2=γ_1/2+γ_φ"
        }
      ],
      "references": [
        "density-qutip-master"
      ]
    },
    {
      "id": "density-exchange",
      "module": "density",
      "title": "从 CG 耦合基到交换产生纠缠",
      "summary": "把 ↑↓ 分解为单重态与三重态，观察相对相位怎样形成纠缠。",
      "preset": "exchange",
      "sections": [
        {
          "title": "选择耦合基解释演化",
          "text": "两个自旋1/2组成 S=0 和 S=1。反平行直积态同时含单重态和三重态；各分量在各向同性交换下获得不同的相位。",
          "formula": "|↑↓⟩=(|T_0⟩+|S⟩)/√2；H/ℏ=J S_A·S_B"
        },
        {
          "title": "交换能级差决定拍频",
          "text": "本模块 J 已是角频率，单重态 H/ℏ 本征值为 −3J/4，三重态为 J/4。去除整体相位后，从 ↑↓ 出发在两个反平行组态之间演化。",
          "formula": "|ψ(t)⟩=cos(Jt/2)|↑↓⟩−i sin(Jt/2)|↓↑⟩"
        },
        {
          "title": "纯态的局部熵能揭示纠缠",
          "text": "Jt=π/2 时两种组态等权但有相对相位，整体仍然纯，局部为 I/2。Jt=π 时系统变成另一反平行直积态，纠缠再次为零。",
          "formula": "N(ρ)=|sin(Jt)|/2（纯交换、初态 ↑↓）"
        },
        {
          "title": "混态要另看纠缠判据",
          "text": "在双自旋上对 B 做部分转置，负本征值的绝对值之和给出负性。它适用于这里的2×2混态；不要把局部熵单独当作混态纠缠。",
          "formula": "N(ρ)=(||ρ^{T_B}||_1−1)/2"
        }
      ],
      "references": [
        "density-qutip-tensor",
        "density-negativity"
      ]
    },
    {
      "id": "density-assumptions",
      "module": "density",
      "title": "从模型约定到可信的演化结果",
      "summary": "区分初态温度、现象学环境和数值采样，检查结果的物理性。",
      "preset": "dephasing-plusx",
      "sections": [
        {
          "title": "初始热态和环境温度不同",
          "text": "thermalScale 只用于当前 H 的初态 Gibbs 权重。设为零时，程序在10⁻¹⁰ rad/ns容差内的整个基态子空间等权平均。它不会自动决定弛豫率或详细平衡。",
          "formula": "ρ(0)=exp[−(H/ℏ)/θ]/Z；θ=k_B T/ℏ"
        },
        {
          "title": "本地通道不自动使耦合系统热化",
          "text": "本实验的 ↑→↓ 与 σ_z 通道定义在固定局部基底中；有驱动或交换时，它们不一定按完整 H 的能量本征态跃迁。不能把所选 γ₁、γ_φ 解释为真实材料浴的完整微观描述。",
          "formula": "dρ/dt=−i[H/ℏ,ρ]+Σ_a(C_aρC_a†−{C_a†C_a,ρ}/2)"
        },
        {
          "title": "迹和半正定性需要同时检查",
          "text": "密度矩阵必须厄米、迹为1且本征值非负。程序报告全轨迹误差，不通过重新归一化或删去负本征值修补动力学。很小的负值可能是浮点误差，但明显负值应被拒绝。",
          "formula": "ρ=ρ†；Trρ=1；λ_min(ρ)≥0"
        },
        {
          "title": "采样过稀与求解错误不是同一件事",
          "text": "常量生成元以矩阵指数传播，可在指定时刻求解；但如果时间点太稀，绘图会漏掉振荡。增加采样点应恢复图形细节，而不应改变相同时刻的物理态。",
          "formula": "ρ(t+Δt)=exp(LΔt)ρ(t)（向量化后）"
        }
      ],
      "references": [
        "density-qutip-master"
      ]
    }
  ],
  "exercises": [
    {
      "id": "density-pure-mixed-exercise",
      "module": "density",
      "lesson": "density-pure-mixed",
      "title": "辨认相同局部态背后的不同整体态",
      "prompt": "对照单重态与反平行经典混合预设。",
      "steps": [
        {
          "prompt": "单重态的整体纯度是多少？",
          "hint": "纯态密度矩阵满足 ρ²=ρ。",
          "choices": [
            "1",
            "1/2",
            "0"
          ],
          "answer": 0,
          "explanation": "单重态是归一化纯态，Trρ²=1。"
        },
        {
          "prompt": "忽略 B 后，A 的约化密度矩阵是什么？",
          "hint": "两种自旋测量结果等概率，且求部分迹后局部相干为零。",
          "choices": [
            "|↑⟩⟨↑|",
            "I/2",
            "零矩阵"
          ],
          "answer": 1,
          "explanation": "ρ_A=I/2，所以局部熵为1 bit。"
        },
        {
          "prompt": "反平行经典等权混合是否也有局部熵1 bit？",
          "hint": "分别对两个反平行直积态取部分迹再求平均。",
          "choices": [
            "没有，熵为0",
            "只有加入驱动后才有",
            "有，但它是可分的经典混合"
          ],
          "answer": 2,
          "explanation": "它与单重态局部态相同，但整体负性为0。"
        },
        {
          "prompt": "哪一个量能区分这两个例子的纠缠？",
          "hint": "使用双自旋部分转置谱。",
          "choices": [
            "负性：单重态1/2，经典混合0",
            "仅局部熵：两个都为1就都纠缠",
            "仅 z 方向布居"
          ],
          "answer": 0,
          "explanation": "负性区分两者；局部熵对一般混态不是单独的纠缠量。"
        }
      ]
    },
    {
      "id": "density-lindblad-exercise",
      "module": "density",
      "lesson": "density-lindblad",
      "title": "分清 T₁、T₂ 与纯退相干",
      "prompt": "取无驱动单自旋 γ₁=0.4、γ_φ=0.1 ns⁻¹。",
      "steps": [
        {
          "prompt": "T₁ 是多少？",
          "hint": "T₁=1/γ₁。",
          "choices": [
            "0.4 ns",
            "2.5 ns",
            "5 ns"
          ],
          "answer": 1,
          "explanation": "1/0.4=2.5 ns。"
        },
        {
          "prompt": "横向包络衰减率是多少？",
          "hint": "γ₂=γ₁/2+γ_φ。",
          "choices": [
            "0.5 ns⁻¹",
            "0.2 ns⁻¹",
            "0.3 ns⁻¹"
          ],
          "answer": 2,
          "explanation": "0.4/2+0.1=0.3 ns⁻¹，T₂=10/3 ns。"
        },
        {
          "prompt": "只保留纯退相干且 Ω=0，z 布居会怎样？",
          "hint": "σ_z 通道与该基底的投影算符对易。",
          "choices": [
            "不变",
            "全部立即转到 ↓",
            "必定变成各1/2"
          ],
          "answer": 0,
          "explanation": "纯退相干衰减非对角元，不直接改变此条件下的布居。"
        },
        {
          "prompt": "drive=1 rad/ns 时的普通频率是多少？",
          "hint": "角频率除以2π。",
          "choices": [
            "1 周期/ns",
            "1/(2π) 周期/ns",
            "2π 周期/ns"
          ],
          "answer": 1,
          "explanation": "H/ℏ 使用角频率，不能把1 rad/ns直接读作1 GHz。"
        }
      ]
    },
    {
      "id": "density-exchange-exercise",
      "module": "density",
      "lesson": "density-exchange",
      "title": "从交换能级到最大纠缠时刻",
      "prompt": "取 J=1 rad/ns、Ω=Δ=δ=γ₁=γ_φ=0，初态 ↑↓。",
      "steps": [
        {
          "prompt": "单重态与三重态的 H/ℏ 本征值分别是什么？",
          "hint": "用 S_A·S_B=[S²−S_A²−S_B²]/2。",
          "choices": [
            "−3/4 与 1/4 rad/ns",
            "−1 与 1 rad/ns",
            "0 与 0 rad/ns"
          ],
          "answer": 0,
          "explanation": "两个自旋1/2有 S_A²=S_B²=3/4，S为0或1。"
        },
        {
          "prompt": "第一次两种反平行组态等权发生在何时？",
          "hint": "cos²(t/2)=sin²(t/2)。",
          "choices": [
            "π ns",
            "π/2 ns",
            "2π ns"
          ],
          "answer": 1,
          "explanation": "t=π/2 ns时两个概率均为1/2。"
        },
        {
          "prompt": "此时整体纯度、局部熵和负性分别是多少？",
          "hint": "幺正演化保纯，局部态为I/2。",
          "choices": [
            "1/2、1、0",
            "1、0、0",
            "1、1 bit、1/2"
          ],
          "answer": 2,
          "explanation": "整体纯且最大纠缠；局部混合由纠缠产生。"
        },
        {
          "prompt": "到 t=π ns 时纠缠是否继续增长？",
          "hint": "此时 cos(t/2)=0。",
          "choices": [
            "否，成为 ↓↑ 直积态，负性回到0",
            "是，负性变为1",
            "纯度变为0"
          ],
          "answer": 0,
          "explanation": "有限双自旋存在相干往返，纠缠不必单调增长。"
        }
      ]
    },
    {
      "id": "density-assumptions-exercise",
      "module": "density",
      "lesson": "density-assumptions",
      "title": "检查热初态、耗散与数值结论",
      "prompt": "在热初态实验中打开局域耗散，再比较稀密时间采样。",
      "steps": [
        {
          "prompt": "thermalScale 决定什么？",
          "hint": "它进入初始Gibbs权重。",
          "choices": [
            "初态 kBT/ℏ",
            "自动推导全部环境噪声",
            "直接等于 γ₁"
          ],
          "answer": 0,
          "explanation": "初态温度尺度与耗散通道参数是独立输入。"
