  "lessons": [
    {
      "id": "layer-periodicity",
      "module": "layers",
      "title": "二维周期不等于二维空间",
      "summary": "平面群作用于二维图案；层群作用于三维空间中的对象，但只有两个独立周期平移。层群可以含翻转法向的操作。教材中的 17 个平面群与 80 个层群回答不同问题。",
      "preset": "layer-square",
      "references": [
        "layer-bcs",
        "layer-db"
      ],
      "sections": [
        {
          "title": "先指定周期方向",
          "text": "平面群作用于二维图案；层群作用于三维空间中的对象，但只有两个独立周期平移。层群可以含翻转法向的操作。教材中的 17 个平面群与 80 个层群回答不同问题。",
          "formula": "r′ = R r + t"
        },
        {
          "title": "把边界写进匹配规则",
          "text": "面内坐标按两条晶格基矢取模，法向不取模。把薄膜塞进有真空的三维周期晶胞，是计算表示；不能直接把超胞的全部周期平移当作孤立薄膜的实际操作。",
          "formula": "R n = ±n"
        },
        {
          "title": "检查一个真实映射",
          "text": "本页从简单立方母体切出薄层，枚举保持晶面方向的矩阵，再查找面内平移。每个原子必须映到同标签原子，且整个映射为双射。",
          "formula": "{R|t}{S|u} = {RS|R u+t}"
        }
      ]
    },
    {
      "id": "layer-termination",
      "module": "layers",
      "title": "切面、终止与两侧交换",
      "summary": "(001)、(110)、(111) 的面内度量不同。同一个法向也不能唯一指定原子终止；成分、层数和切割起点都属于结构输入。",
      "preset": "layer-surface",
      "references": [
        "layer-bcs",
        "layer-db"
      ],
      "sections": [
        {
          "title": "几何面与具体表面",
          "text": "(001)、(110)、(111) 的面内度量不同。同一个法向也不能唯一指定原子终止；成分、层数和切割起点都属于结构输入。",
          "formula": "R n = ±n"
        },
        {
          "title": "辨认翻转法向的操作",
          "text": "Rn=−n 的操作交换薄膜两侧。它可能保持对称薄膜，却破坏只有一侧的吸附标记或异质界面；这不是由群符号单独决定的。",
          "formula": "R n = −n"
        },
        {
          "title": "保持动量和自旋的角色",
          "text": "在正交笛卡尔坐标中，波矢随 R 变换；自旋为轴矢量，另有 det(R)。时间反演会同时反转波矢和自旋，而不移动原子坐标。",
          "formula": "S′ = det(R) R S"
        }
      ]
    },
    {
      "id": "layer-registry",
      "module": "layers",
      "title": "堆垛路径与界面共同对称性",
      "summary": "上半层沿面内基矢连续平移，比较每个操作对全部原子的映射。界面共同对称性还依赖横向配准，不能只比较两侧的抽象点群名称。",
      "preset": "layer-interface",
      "references": [
        "layer-bcs",
        "layer-db"
      ],
      "sections": [
        {
          "title": "用同一面内晶格比较两侧",
          "text": "上半层沿面内基矢连续平移，比较每个操作对全部原子的映射。界面共同对称性还依赖横向配准，不能只比较两侧的抽象点群名称。",
          "formula": "r′ = R r + t"
        },
        {
          "title": "追踪特殊配准点",
          "text": "一般错位可能降低操作数，特殊配准可恢复部分操作。七点曲线是取样记录，不保证发现所有特殊点；可手动输入其他分数错位。",
          "formula": "t = s a_1"
        },
        {
          "title": "把对称许可接到物性",
          "text": "将保留操作带到物性张量课堂，可以继续约束响应分量；操作减少不保证某项响应变大，也不替代微观材料参数。",
          "formula": "R P = P"
        }
      ]
    },
    {
      "id": "chiral-mirror",
      "module": "chirality",
      "title": "结构镜像与正旋转配准",
      "summary": "主动镜像改变构型。被动换基仅改变同一构型的坐标，同时也必须变换晶格和操作矩阵。本实验用明确的 x 反号生成镜像。",
      "preset": "chiral-d3",
      "references": [
        "chirality-iucr",
        "spglib-tol"
      ],
      "sections": [
        {
          "title": "区分主动镜像与坐标描述",
          "text": "主动镜像改变构型。被动换基仅改变同一构型的坐标，同时也必须变换晶格和操作矩阵。本实验用明确的 x 反号生成镜像。",
          "formula": "det(R) = −1"
        },
        {
          "title": "只允许保向刚体配准",
          "text": "枚举同种原子的所有对应，再寻找行列式 +1 的最佳旋转。不同标签不能互换。配准残差为零说明这个有限点集与镜像可重合。",
          "formula": "det(R) = +1"
        },
        {
          "title": "回到空间群的层次",
          "text": "手性晶体结构只能具有保向操作，涉及 65 个 Sohncke 群型；其中 22 个群型组成 11 对对映群型。其余 Sohncke 群型也可容纳手性结构。",
          "formula": "R r = r′"
        }
      ]
    },
    {
      "id": "chiral-polarity",
      "module": "chirality",
      "title": "手性、极性与铁电性的不同问题",
      "summary": "极向量必须被每个群操作保持。将所有 (R−I) 约束联立，可以得到允许方向的维数；D3 原型为零，C4v 锥体只允许轴向。",
      "preset": "chiral-polar",
      "references": [
        "chirality-iucr",
        "spglib-tol"
      ],
      "sections": [
        {
          "title": "直接求允许极向量",
          "text": "极向量必须被每个群操作保持。将所有 (R−I) 约束联立，可以得到允许方向的维数；D3 原型为零，C4v 锥体只允许轴向。",
          "formula": "(R−I) P = 0"
        },
        {
          "title": "手性与极性分别验证",
          "text": "D3 点集可以手性而非极性；C4v 锥体可以极性却因镜面而非手性。无反演也不能替代这两个独立判断。",
          "formula": "R P = P"
        },
        {
          "title": "用独立实验讨论响应",
          "text": "极性只说明对称性许可，不给出自发极化大小或可逆切换。偏振往返模型使用外加旋转角，并明确自然旋光与 Faraday 的回程约定。",
          "formula": "R(−θ) R(θ) = I"
        }
      ]
    },
    {
      "id": "chiral-tolerance",
      "module": "chirality",
      "title": "容差、伪对称与逆向鉴别",
      "summary": "沿固定扰动方向给理想点集加入已知幅度。严格当前构型的对称与理想母构型的近似操作分开记录；几何误差使用模型长度。",
      "preset": "chiral-noise",
      "references": [
        "chirality-iucr",
        "spglib-tol"
      ],
      "sections": [
        {
          "title": "先量化实际位移",
          "text": "沿固定扰动方向给理想点集加入已知幅度。严格当前构型的对称与理想母构型的近似操作分开记录；几何误差使用模型长度。",
          "formula": "δ = max_i |R r_i − r_{p(i)}|"
        },
        {
          "title": "接受集合还要检查闭合",
          "text": "逐操作通过距离阈值并不自动保证组合也通过。容差扫描显示接受数与每个候选的最大残差，闭合失败时不输出严格群名。",
          "formula": "R_1 R_2 ∈ G"
        },
        {
