  "title": "从典型材料认识空间群、双群与磁群",
  "sources": [
    {
      "id": "aflow-nacl",
      "title": "AFLOW：Rock Salt/Halite (NaCl, B1) Structure",
      "url": "https://aflow.org/p/AB_cF8_225_a_b-001/",
      "note": "官方原型库，核验 Fm-3m、fcc 平移和两套相差 (1/2,1/2,1/2) 的位点。模型选择 Na 在原点；交换两套化学基元的原点选择不改变空间群类型。"
    },
    {
      "id": "aflow-diamond",
      "title": "AFLOW：Diamond (A4) Structure",
      "url": "https://aflow.org/p/A_cF8_227_a-001/",
      "note": "官方原型库，核验金刚石结构、Si 同型及 No.227。此页采用原点选项2；课堂将原点平移到一个 Si 原子，使用常见的 0 与 (1/4,1/4,1/4) 基元。"
    },
    {
      "id": "aflow-zincblende",
      "title": "AFLOW：Zincblende (B3) Structure",
      "url": "https://aflow.org/p/AB_cF8_216_a_c-001/",
      "note": "官方原型库，核验 No.216 与两类原子的四面体配位；GaAs 模型按 Ga 在 4a、As 在 4c 选定化学占位。"
    },
    {
      "id": "aflow-bcc",
      "title": "AFLOW：Body-Centered Cubic (A2, bcc) Structure",
      "url": "https://aflow.org/p/A_cI2_229_a-001/",
      "note": "官方原型库，核验 bcc 核位置和 No.229；铁磁方向由本教学模型另行指定。"
    },
    {
      "id": "aflow-rutile",
      "title": "AFLOW：Rutile (TiO2, C4) Structure",
      "url": "https://aflow.org/p/A2B_tP6_136_f_a-001/",
      "note": "官方 rutile 原型，核验 No.136 的 2a/4f 分数坐标；用于 MnF2 的化学结构类型。"
    },
    {
      "id": "stout1954",
      "title": "Stout & Reed (1954)：The Crystal Structure of MnF2, FeF2, CoF2, NiF2 and ZnF2",
      "url": "https://doi.org/10.1021/ja01650a005",
      "note": "原始 X 射线结构研究；MnF2 在 25°C 为 rutile，a=4.8734 Å、c=3.3099 Å、u=0.310(3)。课堂只取舍入的 c/a=0.68 和 u=0.310；不宣称为低温精修。"
    },
    {
      "id": "yamani2010",
      "title": "Yamani, Tun & Ryan (2010)：Neutron scattering study of the classical antiferromagnet MnF2",
      "url": "https://doi.org/10.1139/P10-081",
      "note": "原始中子散射教学实验，支持 rutile 两 Mn 子晶格沿 c 轴反平行的磁序；不将教学中忽略的配体磁矩或有限温度涨落视作严格实验零值。"
    },
    {
      "id": "roth1958",
      "title": "Roth (1958)：Magnetic Structures of MnO, FeO, CoO, and NiO",
      "url": "https://doi.org/10.1103/PhysRev.110.1333",
      "note": "原始中子衍射研究，支持 NiO 的 (111) 铁磁面反铁磁堆垛和面内磁矩。"
    },
    {
      "id": "pomjakushin2024",
      "title": "Pomjakushin (2024)：On the magnetic and crystal structures of NiO and MnO",
      "url": "https://doi.org/10.1107/S205252062400756X",
      "note": "原始衍射研究，讨论低温晶格畸变及磁结构模型判别；提醒不能从理想立方母相或少量操作直接替代实验磁群精修。"
    },
    {
      "id": "weber2024",
      "title": "Weber et al. (2024)：Surface Magnetization in Antiferromagnets: Classification, Example Materials, and Relation to Magnetoelectric Responses",
      "url": "https://doi.org/10.1103/PhysRevX.14.021033",
      "note": "NiO 案例采用 (111) 层和 [11-2] 面内磁矩；课堂据此选定一个理想单磁畴。"
    },
    {
      "id": "bcs-double",
      "title": "Elcoro et al. (2017)：Double crystallographic groups and their representations on the Bilbao Crystallographic Server",
      "url": "https://arxiv.org/abs/1706.09272",
      "note": "双群、SU(2) 提升及双值表示的一手方法论文；以下旋量推导为原创教学例。"
    }
