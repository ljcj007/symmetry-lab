    {
      "id": "site-bloch-little-group",
      "module": "bandrep",
      "title": "从实空间位点到螺旋轴小群"
    },
    {
      "id": "bose-scattering",
      "module": "scattering",
      "title": "从谐振子热占据到双侧声子散射"
    },
    {
      "id": "bulk-interface-localization",
      "module": "domainwall",
      "title": "从 SSH 体相到界面局域态"
    },
    {
      "id": "hund-superexchange",
      "module": "hubbard",
      "title": "区分局域 Hund 自旋与站点间超交换"
    }
  ],
  "models": [
    {
      "module": "band_rep_lab",
      "coverage": [
        "Site orbits, stabilizers, periodic-gauge Bloch matrices and selected-k little-group decomposition for ordinary space groups 2, 4, 19 and 221; scalar s or complete polar p orbitals"
      ],
      "limitations": [
        "BC primitive settings, including the group-4 screw along z; single-valued and no SOC/time reversal",
        "No generic EBR classification, electronic energy calculation, structure identification or complete topological diagnosis"
      ]
    },
    {
      "module": "dynamic_scattering_lab",
      "coverage": [
        "One-dimensional longitudinal diatomic harmonic chain with mass-normalized complex modes, coherent one-phonon amplitudes, Bose populations and positive/negative energy scattering"
      ],
      "limitations": [
        "Synthetic chain with explicit energy cutoff and relative scattering weights; no arbitrary Phonopy dataset import",
        "No fitted material cross section, Debye-Waller factor, elastic/multiphonon scattering or computed damping"
      ]
    },
    {
      "module": "domain_wall_lab",
      "coverage": [
        "Independent scalar phi4 pinned-wall finite-grid stationary calculation with continuum and Hessian diagnostics",
        "Independent finite open SSH chain with central-pair potential, LDOS and selected-subspace spatial projectors"
      ],
      "limitations": [
        "Reduced continuum units do not automatically map to SSH parameters or fitted ferroelectric energies",
        "Finite-grid residual is distinct from unconstrained stability; spatial windows may overlap and finite chains need not reach asymptotic dimerization"
      ]
    },
    {
      "module": "hubbard_lab",
      "coverage": [
        "Exact fermionic diagonalization of 2-4 site open/periodic single-band Hubbard clusters in fixed up/down particle sectors",
        "Degenerate-ground-state trace averages, densities, double occupancy, spin correlations, U scans, all-Sz charge gaps and dimer singlet-triplet splitting"
      ],
      "limitations": [
        "Two-site periodic model has one undirected bond; zero temperature and supplied model parameters",
        "Finite-sector gaps and finite-cluster charge costs do not prove a thermodynamic Mott transition or material magnetic order"
      ]
    }
  ],
