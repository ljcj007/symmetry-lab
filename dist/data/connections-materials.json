  "lessons": [
    {
      "id": "statistics-complete-exchange",
      "module": "statistics",
      "title": "交换的是完整粒子",
      "summary": "电子具有轨道与自旋自由度。交换两个相同电子时，两部分都必须交换。玻色子的完整态取对称交换条件，费米子取反对称条件；局域可区分自旋无需强加粒子统计条件。",
      "preset": "pauli-singlet",
      "references": [
        "neil"
      ],
      "sections": [
        {
          "title": "先确定单粒子自由度",
          "text": "电子具有轨道与自旋自由度。交换两个相同电子时，两部分都必须交换。玻色子的完整态取对称交换条件，费米子取反对称条件；局域可区分自旋无需强加粒子统计条件。",
          "formula": "P = P_orb ⊗ P_spin"
        },
        {
          "title": "构造自旋与轨道的组合",
          "text": "单重态自旋反对称，三重态自旋对称。完整电子波函数必须反对称，所以两部分交换奇偶相反。",
          "formula": "η_total = η_orb η_spin"
        },
        {
          "title": "把允许性与能量分开",
          "text": "交换条件筛去不允许的态。剩余态谁低谁高，需要具体 Hamiltonian；Pauli 原理本身不给出 Hund 能量差。",
          "formula": "P_- = (I − P)/2"
        }
      ]
    },
    {
      "id": "statistics-pauli-projector",
      "module": "statistics",
      "title": "用投影找出 Pauli 禁戒",
      "summary": "二体交换算符的平方为单位。由此构造对称和反对称正交投影。",
      "preset": "pauli-forbidden",
      "references": [
        "neil"
      ],
      "sections": [
        {
          "title": "交换两次回到原态",
          "text": "二体交换算符的平方为单位。由此构造对称和反对称正交投影。",
          "formula": "P^2 = I"
        },
        {
          "title": "为什么系数是二分之一",
          "text": "展开 (I−P)²=2(I−P)，幂等性要求非零归一化系数为 1/2。",
          "formula": "P_-^2 = P_-"
        },
        {
          "title": "零向量不是归一化失败",
          "text": "同轨道且同自旋的两个电子总态对称，反对称投影严格为零。这是统计禁戒，不是数值误差。",
          "formula": "P_- ψ = 0"
        }
      ]
    },
    {
      "id": "statistics-young-sectors",
      "module": "statistics",
      "title": "S₃、中心投影与 Young 对称化",
      "summary": "三个二能级张量因子有八维空间。S₃ 的六个操作在这个空间中产生具体置换矩阵。",
      "preset": "young-three",
      "references": [
        "neil"
      ],
      "sections": [
        {
          "title": "六个置换的作用",
          "text": "三个二能级张量因子有八维空间。S₃ 的六个操作在这个空间中产生具体置换矩阵。",
          "formula": "dim V = 2^3"
        },
        {
          "title": "完整的中心分解",
          "text": "等权平均给对称投影，带置换符号平均给反对称投影，其余为混合中心投影；三个秩依次为 4、0、4。",
          "formula": "P_mix = I − P_sym − P_alt"
        },
        {
          "title": "Young 与正交投影不同",
          "text": "指定表格第一行 1、2，第二行 3，按先列反对称再行对称作用，Y=(I+P₁₂)(I−P₁₃)。Y/3 幂等但非厄米。",
          "formula": "Y^2 = 3Y"
        }
      ]
    },
    {
      "id": "defects-manifold",
      "module": "defects",
      "title": "从剩余对称性到序参量空间",
      "summary": "G 是模型的对称群，H 是一个选定有序态保持的子群；轨道 G/H 给出与其对称相关的可能状态。",
      "preset": "vortex-one",
      "references": [
        "tong"
      ],
      "sections": [
        {
          "title": "G 与 H 描述不同对象",
          "text": "G 是模型的对称群，H 是一个选定有序态保持的子群；轨道 G/H 给出与其对称相关的可能状态。",
          "formula": "M = G/H"
        },
        {
          "title": "离散点、圆和球",
          "text": "Ising 的两个真空不连通；平面 XY 有序态构成圆；三维单位矢量构成球。不同允许态空间有不同的缺陷分类。",
          "formula": "S^1"
        },
        {
          "title": "约束决定分类适用范围",
          "text": "XY 环绕角度的整数绕数依赖序参量留在平面且环路上有定义。允许出平面或核心失序时，需要重新检查条件。",
          "formula": "w = Δθ/(2π)"
        }
      ]
    },
    {
      "id": "defects-winding",
      "module": "defects",
      "title": "闭环、核心与绕数",
      "summary": "相邻采样点的主值相位差相加，除以 2π 得到绕数；采样步长太大会把大转角折叠。",
      "preset": "vortex-pair",
      "references": [
        "tong"
      ],
      "sections": [
        {
          "title": "沿闭环累加相位",
          "text": "相邻采样点的主值相位差相加，除以 2π 得到绕数；采样步长太大会把大转角折叠。",
          "formula": "w = Δθ/(2π)"
        },
        {
          "title": "环路不能穿过核心",
          "text": "核心处角度没有定义。程序同时检查核心距离、最大相位步长和解析包围电荷。",
          "formula": "ψ = exp(iθ)"
        },
        {
          "title": "成对湮灭需要过程条件",
          "text": "包围一对正负涡旋的净绕数为零，但其中仍有两个核心。间距参数为零给出均匀解析终点；滑动此参数不是动力学模拟。",
          "formula": "w_total = w_1 + w_2"
        }
      ]
    },
    {
      "id": "defects-director",
      "module": "defects",
      "title": "指向矢、半圈转角与畴壁",
      "summary": "平面向列将 n 与 −n 视为同态，所以 θ 的周期是 π。这里是 RP¹，不是三维 RP²。",
      "preset": "nematic-half",
      "references": [
        "tong"
      ],
      "sections": [
        {
          "title": "平面指向矢正反等价",
          "text": "平面向列将 n 与 −n 视为同态，所以 θ 的周期是 π。这里是 RP¹，不是三维 RP²。",
          "formula": "n ≡ −n"
        },
        {
          "title": "使用单值双角场",
          "text": "exp(2iθ) 沿闭环绕一圈，对应指向矢角度绕转 π，即 Δθ/(2π)=1/2。",
          "formula": "ψ = exp(2iθ)"
        },
        {
          "title": "拓扑与能量分开",
          "text": "拓扑分类讨论在规定边界与非奇异约束下能否连续变形；稳定性还需要自由能、尺寸与边界条件。",
          "formula": "Δθ/(2π) = 1/2"
        }
      ]
    },
    {
      "id": "reciprocity-onsager",
      "module": "reciprocity",
      "title": "从变量奇偶到互易关系",
      "summary": "在线性、近稳态框架下，用与熵产生相匹配的流和力定义 L。ε 是对应热力学状态变量的时间反演奇偶。",
      "preset": "onsager-hall",
      "references": [
        "onsager"
      ],
      "sections": [
        {
          "title": "先选共轭变量",
