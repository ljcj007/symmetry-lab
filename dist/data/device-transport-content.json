  "lessons": [
    {
      "id": "device-open",
      "module": "device",
      "title": "从封闭能级到接上电极的器件",
      "summary": "把有限链、半无限引线和两端电导放在同一个模型里。",
      "preset": "device-perfect",
      "references": [
        "device-kwant",
        "device-kwant-paper"
      ],
      "sections": [
        {
          "title": "器件需要边界条件",
          "text": "封闭有限链只有离散本征能级。输运问题还需要左、右电极作为粒子库；在本模型中，两根相同半无限均匀链连接有限散射区首尾站点。散射区可为均匀链或交替键的SSH链，Hamiltonian的非对角元均取−t。",
          "formula": "HD=Σi εi|i><i|−Σi ti(|i><i+1|+h.c.)"
        },
        {
          "title": "电极只在带内提供传播通道",
          "text": "均匀引线的能带范围为ε₀±2t₀。其迟致表面Green函数必须选择虚部非正、远离能带时趋向1/E的解。接触自能把开放边界写进有限矩阵；接触跃迁v不是一个独立的弛豫时间。",
          "formula": "gʳ=[E+i0−ε₀−t₀²gʳ]⁻¹；Σ=v²gʳ，Γ=−2 ImΣ"
        },
        {
          "title": "透射概率与电导的区别",
          "text": "每个自旋的电极至多有一个传播通道，透射T在0到1之间。零温线性电导为gs(e²/h)T(EF)。gs=2只是两份相同且独立的自旋通道，不能用它代替真正的自旋轨道耦合；页面中的能量滑块指定EF。",
          "formula": "G=gs(e²/h)T(EF)；e²/h≈38.7405 μS"
        },
        {
          "title": "理想链是第一项基准",
          "text": "散射区跃迁、在位能和接触都与电极匹配时，带内没有物理反射，η→0时T=1。数值正虚部会造成微小人工吸收，程序同时显示它及守恒残差。恰在带边的群速度为零，本实验不把该点当作开放传播通道。",
          "formula": "匹配均匀链：|E−ε₀|<2t₀ ⇒ T→1"
        }
      ]
    },
    {
      "id": "device-scattering",
      "module": "device",
      "title": "势垒、共振与局域谱",
      "summary": "比较看起来都有谱峰、却可能有不同传输能力的器件。",
      "preset": "device-barrier",
      "references": [
        "device-kwant",
        "device-kwant-paper"
      ],
      "sections": [
        {
          "title": "一个站点也能反射电子",
          "text": "在匹配均匀链中加入一个在位势V，有限的反射来自散射振幅干涉。对t=1、其他在位能为0的单点势垒，可用解析透射直接核验程序；移动势垒位置不改变无限均匀背景上的单散射体透射概率。",
          "formula": "T(E)=(4t²−E²)/(4t²−E²+V²)，|E|<2t"
        },
        {
          "title": "弱接触把离散能级变成共振",
          "text": "弱接触有限链的透射峰通常位于被电极移动和展宽的能级附近。对称接触可在共振处给出很高的透射，但离开共振后T很低。增加接触既改变宽度也改变能级与干涉，不能仅凭接触更强推断固定能量的T必定增加。",
          "formula": "T=ΓLΓR|GʳN1|²；Gʳ=[(E+iη)I−HD−ΣL−ΣR]⁻¹"
        },
        {
          "title": "局域态密度不是通过概率",
          "text": "LDOS描述所选能量在每个站点的局域谱权重；左、右注入密度进一步说明哪些谱权重可被各自电极激发。把一侧接触设为0时，LDOS仍可出现峰，而两端透射严格为0。图中的LDOS按每个自旋、每eV给出，不是电子占据数。",
          "formula": "ρi=−ImGʳii/π；νL,i=ΓL|Gʳi1|²/(2π)"
        },
        {
          "title": "扫描需要解析窄峰",
          "text": "单条能量扫描的离散点不能证明所有共振都已采到。应同时缩小扫描窗口、增加采样点，并改变η；不要通过人为增加η把漂亮平滑曲线误当作已收敛结果。",
          "formula": "ΔE=(Emax−Emin)/(Nsamples−1)"
        }
      ]
    },
    {
      "id": "device-ssh",
      "module": "device",
      "title": "SSH 端态、接触与通量连续性",
      "summary": "把已有Zak相位和有限链谱连接到真正开放的两端器件。",
      "preset": "device-ssh-weak",
      "references": [
        "device-kwant",
        "device-local"
      ],
      "sections": [
        {
          "title": "保持同一个胞内胞间约定",
          "text": "这里第0条键连接站点0和1，定义为胞内键t₁=t×dimerRatio，下一条为胞间键t₂=t。偶数站点、弱胞内键的有限链可有低能端态；有限长度使两端波函数重叠，能量一般不精确为0。整体跃迁负号不改变SSH能带的Zak相位模2π，但比较时仍须保持轨道与晶胞约定。",
          "formula": "t₁=t×dimerRatio；t₂=t；N=12的封闭链可与同参数周期模型比较"
        },
        {
          "title": "端态存在不保证高电导",
          "text": "同一N=12、t₁=.6、t₂=1的链，在E=.05 eV处，接触从.15改为.8 eV会改变共振宽度和耦合；需要计算T而不是只观察端点LDOS。本课程用预设让模型和能量保持不变，仅改变接触。",
          "formula": "几何/拓扑诊断 → 封闭链能级 → 电极自能 → T(E)"
        },
        {
          "title": "每条键上的流必须核对",
          "text": "取左电极单位入射通量，ψ=√ΓLGʳe₁，正向键通量定义为从站点i流向i+1。没有真实散射或吸收时，各键通量相同；数值η引入的损失在每个站点都可精确计算。该无量纲通量不是有限偏压的安培电流。",
          "formula": "Ji→i+1=−2Im(Hi,i+1 ψi+1ψi*)；Jin−Jout=2η|ψi|²"
        },
        {
          "title": "把计算证据带回研究记录",
          "text": "保存两种接触下的T(E)、选定能量、LDOS、η比较和连续性残差，再写出是否支持结论。Zak相位不能仅由两端透射峰反推出；真实材料仍需完整轨道、电极、散射与结构参数。",
          "formula": "T+R+Aη=1；Aη=2ηΣi|ψi|²"
        }
      ]
    }
  ],
