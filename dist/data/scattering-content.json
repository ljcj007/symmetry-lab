  "lessons": [
    {
      "id": "scattering-chain",
      "module": "scattering",
      "title": "从双原子运动方程到两条声子分支",
      "summary": "先固定质量归一化和 Bloch 规范，再看能量与实际位移。",
      "preset": "scattering-diatomic",
      "sections": [
        {
          "title": "原胞与两根弹簧",
          "text": "A_l—B_l 的弹簧是 K₁，B_l—A_(l+1) 的弹簧是 K₂。原胞长度 a，B 位于 sa。K、质量和基底位置都是独立给定参数；改变 s 不会自动重新拟合弹簧。",
          "formula": "V=½Σ_l[K₁(u_lB−u_lA)²+K₂(u_(l+1)A−u_lB)²]"
        },
        {
          "title": "本征矢不等于原子的同单位位移",
          "text": "程序在质量归一化基中求解二乘二厄米矩阵。Γ 点声学本征矢正比于(√mA,√mB)，除以√m后才得到两个原子同幅同相的实际位移。",
          "formula": "u_lκ∝eκ(q)exp(iqla)/√mκ；Σκ|eκ|²=1"
        },
        {
          "title": "两支能量的解析检查",
          "text": "把 t 定义为(K₁+K₂)(1/mA+1/mB)，d 定义为4K₁K₂sin²(qa/2)/(mAmB)。λ±是动力学矩阵本征值，能量转换因子 C≈64.654 meV。Γ 点低支为刚体平移，高支为有限频率的相对运动。",
          "formula": "λ±=[t±√(t²−4d)]/2；ε±=C√λ±"
        },
        {
          "title": "为什么能谱里没有 Γ 点零频峰",
          "text": "一声子公式含1/ε，不能把刚体平移直接代入。程序保留零频色散，但把低于显式截断的模从非弹性谱排除。未计算弹性或准弹性峰；这不是给声学模人为开隙。",
          "formula": "ε<energyCutoff ⇒ 不计入一声子谱"
        }
      ],
      "references": [
        "scattering-phonopy-formulation",
        "scattering-togo-2023"
      ]
    },
    {
      "id": "scattering-phase",
      "module": "scattering",
      "title": "相同声子，为何在相邻倒格区明暗不同？",
      "summary": "区分完整 Q 与约化 q，把投影、基底相位和质量因子放进同一个振幅。",
      "preset": "scattering-folded-even",
      "sections": [
        {
          "title": "散射向量不是声子约化动量",
          "text": "Q 是带符号的完整扫描坐标；Q∥=Qcosθ 是链轴投影。约化 q 折叠到第一布里渊区，Q∥−q 是倒格向量。两个相隔倒格向量的测量点可以有相同声子能量，却不必有相同强度。",
          "formula": "Q∥=q+2πn/a"
        },
        {
          "title": "先叠加振幅，再取平方",
          "text": "相干散射必须把两个原子的复振幅先相加。b 是有符号相对散射振幅，e 是质量归一化本征矢。当前规范下创建振幅必须使用 e 的复共轭；漏掉相位或共轭都会改变消光。",
          "formula": "Aν=Q∥Σκ bκ exp(iQ∥τκ)eκ(q)*/√mκ；Wν=(ℏ²/2amu)|Aν|²/εν"
        },
        {
          "title": "在单原子折叠极限手算消光",
          "text": "令两质量、两弹簧、两散射振幅分别相等，s=1/2。原胞只是把单原子链加倍。偶数倒格区的光学折叠支消光，奇数区的声学折叠支消光。切换偶数/奇数预设时 Hamiltonian 不变，只改变完整 Q。",
          "formula": "Aac∝1+(−1)^n；Aop∝1−(−1)^n"
        },
        {
          "title": "方向投影与简并需要分开处理",
          "text": "Q垂直链轴时纵向 Q·e 为零，所以本模型全部变暗。改变角度同时改变约化q，不能仅看cos²θ。严格简并处逐本征矢强度不是唯一可观测量，程序按简并子空间总和报告。",
          "formula": "Σν|Aν|²=Q∥²(bA²/mA+bB²/mB)"
        }
      ],
      "references": [
        "scattering-phonopy-dsf",
        "scattering-phonopy-formulation"
      ]
    },
    {
      "id": "scattering-temperature",
      "module": "scattering",
      "title": "用 Stokes / anti-Stokes 读出温度与模型边界",
      "summary": "从 Bose 因子推导详细平衡，并区分展宽、截断、材料数据与真实寿命。",
      "preset": "scattering-warm",
      "sections": [
        {
          "title": "正能量是探针损失能量",
          "text": "本页 Stokes 在+ε，代表创建声子；anti-Stokes 在−ε，代表湮灭已有声子。前者包含 n+1，后者只含 n，因此零温仍可创建声子，却不能湮灭热声子。",
          "formula": "n=1/[exp(ε/kBT)−1]；I+=W(n+1)，I−=Wn"
        },
        {
          "title": "详细平衡检查的是单模权重",
          "text": "本模型实力常数与实散射权重满足时间反演，因此同Q的创建/湮灭有相同裸权重。逐模比值直接检验Bose统计；若两过程都暗，比值没有实验意义。",
          "formula": "I−/I+=exp(−ε/kBT)"
        },
        {
          "title": "展宽不是寿命，采样不是积分",
          "text": "Gaussian σ是给定分辨率的标准差，峰面积保持权重。程序用erf算有限窗口积分，并检查ΔE≤σ/2。峰尾跨过零能量和多峰叠加后，逐采样点强度比不再等于简单的详细平衡式。",
          "formula": "FWHM=2√(2ln2)σ"
        },
        {
          "title": "从模型迈向真实文件要补什么",
          "text": "无限一维模型的长波涨落和本页省略的Debye–Waller不能忽略。本版不接收真实Phonopy散射输入：现有导入只保留所选单模的完整本征矢。真实计算需原胞、Å单位、质量、全模复本征矢、Q/q匹配、散射权重和合适的热振动因子。低能截断与有限Q网格必须随结果报告。"
        }
      ],
      "references": [
        "scattering-phonopy-dsf",
        "scattering-togo-2023"
      ]
    }
  ],
  "exercises": [
    {
      "id": "scattering-mass-exercise",
      "module": "scattering",
      "lesson": "scattering-chain",
      "title": "从平移零模推导质量因子",
      "prompt": "使用双原子链预设，先在纸上检查Γ点，再读取计算结果。",
      "steps": [
        {
          "prompt": "Γ 点刚体平移意味着哪种实际位移？",
          "hint": "平移没有改变任何弹簧长度。",
          "choices": [
            "A、B同幅同相",
            "A、B同幅反相",
            "重原子必须静止"
          ],
          "answer": 0,
          "explanation": "同幅同相保持所有相对距离，所以是零恢复力的声学模式。"
        },
        {
          "prompt": "质量归一化本征矢 eA:eB 应是什么？",
          "hint": "实际位移为eκ/√mκ。",
          "choices": [
            "mA:mB",
            "√mA:√mB",
            "1:1总是成立"
          ],
          "answer": 1,
          "explanation": "为了让eA/√mA=eB/√mB，必须取eA:eB=√mA:√mB。"
        },
        {
          "prompt": "在Γ点，光学能量的平方与哪个量成正比？",
          "hint": "二乘二矩阵一个本征值为0，另一个等于迹。",
          "choices": [
            "K₁−K₂",
            "mA+mB",
            "(K₁+K₂)(1/mA+1/mB)"
          ],
          "answer": 2,
          "explanation": "λop=TrD=(K₁+K₂)(1/mA+1/mB)，再乘能量转换常数的平方。"
        },
        {
          "prompt": "应怎样把Γ点零频声学模放入当前非弹性谱？",
          "hint": "公式有1/ε，本页没有弹性散射模型。",
          "choices": [
            "直接除以零",
            "按显式低能截断排除并报告",
            "把它替换成任意有限能量"
          ],
          "answer": 1,
          "explanation": "保留零频色散，但从一声子非弹性公式排除；不能用展宽或任意能量伪造弹性峰。"
        }
      ]
    },
    {
      "id": "scattering-extinction-exercise",
      "module": "scattering",
      "lesson": "scattering-phase",
      "title": "相邻倒格区的消光交换",
      "prompt": "比较“相同原子·偶数倒格区”和“相邻奇数倒格区”；两者只改变完整Q。",
      "steps": [
        {
          "prompt": "Q增加2π/a后，约化q发生什么？",
          "hint": "对倒格向量取模。",
          "choices": [
            "回到同一约化q",
            "始终增加一倍",
            "变成Γ点"
          ],
          "answer": 0,
          "explanation": "约化q不变，因此同一Hamiltonian的声子能量相同。"
        },
        {
          "prompt": "s=1/2时，跨一个倒格区给B基底增加什么相位？",
          "hint": "计算exp[i(2π/a)(a/2)]。",
          "choices": [
            "+1",
            "−1",
            "0"
          ],
          "answer": 1,
          "explanation": "额外相位为exp(iπ)=−1；A位于原点，不获得此额外相位。"
        },
        {
          "prompt": "奇数倒格区，声学与光学振幅因子分别是什么？",
          "hint": "代入1+(−1)^n与1−(−1)^n。",
          "choices": [
            "2与0",
            "1与1",
            "0与2"
          ],
          "answer": 2,
          "explanation": "声学相干振幅抵消，光学相加；这不代表声学模式不存在。"
        },
        {
          "prompt": "两个预设中的裸峰权重为何不能直接只用0或4来比较？",
          "hint": "散射式还含完整Q投影、质量和1/能量。",
          "choices": [
            "还需保留Q∥²、质量与1/ε因子",
            "因为程序改变了温度",
            "因为相邻区一定有不同力常数"
          ],
          "answer": 0,
          "explanation": "0/4是干涉因子；完整Q大小不同也会改变Q∥²，所以亮支的绝对相对权重不必相等。"
        }
      ]
