  "lessons": [
    {
      "id": "exchange-bond-constraints",
      "module": "exchange",
      "title": "从一条键的对称性得到允许交换",
      "summary": "同一个空间操作既变换自旋分量，也可能交换键的两个端点。",
      "preset": "exchange-plane",
      "references": [
        "moriya",
        "feynman-angular"
      ],
      "sections": [
        {
          "title": "先声明有向键和自旋约定",
          "text": "把i放在(−1/2,0,0)、j放在(1/2,0,0)。J是实3×3矩阵，量子自旋S=σ/2无量纲，所有交换系数单位为meV。翻转箭头不是新增相互作用。",
          "formula": "H_{ij}=S_i^T J_{ij} S_j"
        },
        {
          "title": "自旋是轴向量",
          "text": "空间位置按R变换，真实自旋按A=det(R)R变换。反演使位置反向而保持自旋分量；镜面下不能把自旋当作普通位移。",
          "formula": "A=det(R)R"
        },
        {
          "title": "端点交换决定是否转置",
          "text": "操作保持两个端点时，变换后的能量由A^TJA给出；操作交换端点时，需要再把自旋次序恢复为i在左、j在右，因此出现J^T。界面会列出该操作生成的每一条线性系数关系。",
          "formula": "J=A^T J A；J=A^T J^T A"
        },
        {
          "title": "一个生成元的结论与完整群",
          "text": "沿x的键位于xy镜面内，允许的D垂直于这个镜面；键中心反演要求J对称，禁止全部DMI。程序对所选生成元求共同解，并检查生成群闭包。对称性只决定允许空间，不给出真实材料的交换大小。"
        }
      ]
    },
    {
      "id": "exchange-classical-quantum",
      "module": "exchange",
      "title": "经典倾斜与量子能级是不同问题",
      "summary": "相同交换矩阵作用于单位经典箭头或自旋1/2算符时，结果的解释和归一化不同。",
      "preset": "exchange-plane",
      "references": [
        "moriya",
        "feynman-angular"
      ],
      "sections": [
        {
          "title": "把交换矩阵拆开",
          "text": "J的迹给出各向同性部分，对称无迹部分给出各向异性，反对称部分对应D·(Si×Sj)。本站约定Jxy−Jyx=2Dz，先核对这个符号再比较文献。",
          "formula": "J=J_{iso} I+Γ+K(D)；H_D=D·(S_i×S_j)"
        },
        {
          "title": "单位经典箭头的全局极小值",
          "text": "对两个单位向量，最低双线性能量等于J最大奇异值的负值。左右奇异向量给出一个极小态代表；简并时代表不唯一。另画出的xy平面试探曲线固定第一个自旋，不能普遍等同于全局最小值。",
          "formula": "E_{min}=−s_{max}(J)"
        },
        {
          "title": "量子二聚体直接对角化",
          "text": "用σa⊗σb/4构造4×4矩阵。当只有各向同性反铁磁J时，单重态能量−3J/4，三重态能量J/4。经典能量−J与量子能量−3J/4不能未经归一化就相等比较。",
          "formula": "H=Σ_{ab} J_{ab} σ_a⊗σ_b/4"
        },
        {
          "title": "倾斜箭头不是量子局域磁矩",
          "text": "界面报告量子基态简并子空间的等权密度矩阵和自旋关联。两个自旋1/2整体的时间反演平方是+1，时间反演本身不保证Kramers配对；能级简并也可能依赖特殊参数。"
        }
      ]
    },
    {
      "id": "exchange-conventions",
      "module": "exchange",
      "title": "换坐标、交换端点与可比较的物理结果",
      "summary": "区别改变对称约束、改变相互作用和仅改变表示约定。",
      "preset": "exchange-convention",
      "references": [
        "moriya",
        "feynman-angular"
      ],
      "sections": [
        {
          "title": "坐标轴旋转采用被动约定",
          "text": "新轴相对旧轴绕z旋转θ，分量满足v′=Q^Tv。交换矩阵随两侧自旋分量一致变换；这里是右手坐标轴的正交旋转。",
          "formula": "J′=Q^T J Q；D′=Q^T D"
        },
        {
          "title": "交换有向键的端点",
          "text": "把i与j互换后，J变为J^T，D变号。与此同时叉积中的两个自旋也交换次序，能量不会因此改变。",
          "formula": "J_{ji}=J_{ij}^T；D_{ji}=−D_{ij}"
        },
        {
          "title": "用不变量而非分量外观比较",
          "text": "界面同时列出原张量、换约定后的张量和两套量子能级。矩阵元素看起来不同，四个能量、经典极小能量与自旋夹角应保持。改变对称性开关则可能真正改变模型。"
        },
        {
          "title": "与材料模型的连接",
          "text": "这里使用一条抽象键说明Moriya约束。可连接磁振子和有效自旋共振课程，但不从一条键自动推断晶格磁序，也不将教学D值当作某种材料的计算结果。"
        }
      ]
    }
  ],
  "exercises": [
    {
      "id": "exchange-bond-exercise",
      "module": "exchange",
      "lesson": "exchange-bond-constraints",
      "title": "逐步推导键中心反演如何禁止DMI",
      "prompt": "先保留包含键的xy镜面，再打开键中心反演；把位置变换、自旋变换和端点次序分别写清。",
      "steps": [
        {
          "prompt": "空间反演R=−I对轴向自旋的变换矩阵是什么？",
          "hint": "计算det(R)R。",
          "choices": [
            "A=I",
            "A=−I",
            "A=0"
          ],
          "answer": 0,
          "explanation": "det(−I)=−1，所以A=I；自旋是轴向量。"
        },
        {
          "prompt": "键中心反演是否交换i、j？",
          "hint": "两个端点位于x=±1/2。",
          "choices": [
            "不交换",
            "交换",
            "只交换z分量"
          ],
          "answer": 1,
          "explanation": "反演把两端点互换，需要把输出的自旋次序重新排为i在左。"
        },
        {
          "prompt": "能量不变给出哪条矩阵条件？",
          "hint": "A=I，但端点交换。",
          "choices": [
            "J=−J",
            "J=0",
            "J=J^T"
          ],
          "answer": 2,
          "explanation": "反演约束去掉反对称部分，保留任意实对称交换矩阵。"
        },
        {
          "prompt": "D向量的结论是什么？",
          "hint": "D由J的反对称部分给出。",
          "choices": [
            "D=0，但对称交换仍可存在",
            "所有交换都为0",
            "D大小由点群唯一决定"
          ],
          "answer": 0,
          "explanation": "反演禁止DMI；它没有要求各向同性或全部对称各向异性也消失。"
        }
      ]
    },
