  "lessons": [
    {
      "id": "workshop-identity",
      "module": "workshop",
      "title": "从矩阵恒等式到系数约束",
      "summary": "这里的两个分量是真实自旋双重态，具有相同反演宇称。Pauli 矩阵按轴向量变换；换成任意两个轨道，必须重新指定表示矩阵。",
      "preset": "workshop-rashba",
      "sections": [
        {
          "title": "先固定表示空间",
          "text": "这里的两个分量是真实自旋双重态，具有相同反演宇称。Pauli 矩阵按轴向量变换；换成任意两个轨道，必须重新指定表示矩阵。",
          "formula": "H(k)=d_0(k)I+d_x(k)σ_x+d_y(k)σ_y+d_z(k)σ_z"
        },
        {
          "title": "比较所有动量的系数",
          "text": "二阶二维多项式有6个单项式，每个乘以4个Hermitian基矩阵，共24个实系数。生成元给出齐次线性约束；不能只在几个高对称点比较能量。",
          "formula": "H(Rk)=U H(k) U†"
        },
        {
          "title": "先求允许空间，再投影",
          "text": "将输入系数正交投影至约束矩阵的零空间。系数之间可能需要组合：单个 k_x σ_y 并不独立满足 C₄ 旋转，而 Rashba 组合可以。",
          "formula": "H_R=α(k_y σ_x−k_x σ_y)"
        },
        {
          "title": "查看投影的含义",
          "text": "工坊给出每项前后系数、独立维数、完整多项式残差和Γ附近曲线。零空间求解是数值的；系数投影依赖声明的单项式欧氏度量，不能当作材料参数拟合。",
          "formula": "A a=0"
        }
      ],
      "references": [
        "qsymm"
      ]
    },
    {
      "id": "workshop-spin",
      "module": "workshop",
      "title": "为什么反演加时间反演消除这里的自旋分裂",
      "summary": "对于真实自旋一半，时间反演包含复共轭，平方为−1。标量部分对动量为偶，自旋部分为奇。",
      "preset": "workshop-inversion",
      "sections": [
        {
          "title": "时间反演反转自旋",
          "text": "对于真实自旋一半，时间反演包含复共轭，平方为−1。标量部分对动量为偶，自旋部分为奇。",
          "formula": "d_0(−k)=d_0(k)；d(−k)=−d(k)"
        },
        {
          "title": "反演不反转轴向量自旋",
          "text": "本工坊两个态同宇称，反演表示为共同的正或负单位阵。反演约束使自旋部分也成为偶函数。",
          "formula": "d(−k)=d(k)"
        },
        {
          "title": "同一项同时为奇和偶",
          "text": "两个条件合并后自旋部分消失，因此两条能带在每个k简并。这个结论依赖所用同宇称双态空间，不可照搬到任意多轨道有效模型。",
          "formula": "d(k)=0"
        },
        {
          "title": "开关与群名要一致",
          "text": "关闭镜面或旋转后，页面只声称保留剩余生成元。额外加入反演可能扩大对称群，不能仍把它简单叫原来的 C₄ᵥ。",
          "formula": "E_{±}=d_0±|d|"
        }
      ],
      "references": [
        "qsymm"
      ]
    },
    {
      "id": "workshop-breaking",
      "module": "workshop",
      "title": "用受控对照辨认磁性开隙",
      "summary": "绕z旋转允许常数 σ_z；xz镜面将轴向量z分量反转，时间反演也反转它。只有解除对应限制，输入m才能保留。",
      "preset": "workshop-magnetic",
      "sections": [
        {
          "title": "保留旋转时的常数项",
          "text": "绕z旋转允许常数 σ_z；xz镜面将轴向量z分量反转，时间反演也反转它。只有解除对应限制，输入m才能保留。",
          "formula": "H_m=mσ_z"
        },
        {
          "title": "只改变一个开关",
          "text": "把“只保留旋转”结果固定为A，再只启用时间反演计算B。比较Γ点劈裂和同一条k路径；不要同时改变m和生成元。",
          "formula": "Δ_Γ=2|d(0)|"
        },
        {
          "title": "色散不等于完整拓扑诊断",
          "text": "这个低阶Γ附近模型没有完整布里渊区及晶格正则化。即使出现质量项，也不能由这一条局部能带曲线确定材料Chern数。",
          "formula": "E_{±}(k)=d_0(k)±|d(k)|"
        },
        {
          "title": "回到矩阵条件解释现象",
          "text": "项目结论应写出被破坏的生成元、改变的系数和物理后果。若图上看似简并，仍要检验完整系数约束，避免数值或路径偶然简并。",
          "formula": "H(−k)=σ_y H(k)* σ_y"
        }
      ],
      "references": [
        "qsymm"
      ]
    }
  ],
  "exercises": [
    {
      "id": "workshop-identity-exercise",
      "module": "workshop",
      "lesson": "workshop-identity",
      "title": "从矩阵恒等式到系数约束：分步验证",
      "prompt": "先根据表示和生成元推导，再在工坊运行预设核对。",
