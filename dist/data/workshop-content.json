          "answer": 1,
          "explanation": "比较整个多项式系数，而非单独的能量。"
        },
        {
          "prompt": "C₄ᵥ中的线性自旋项应怎样检查？",
          "hint": "旋转会混合x与y。",
          "choices": [
            "逐个删掉所有一次项",
            "只留k_x",
            "检验Rashba等完整组合"
          ],
          "answer": 2,
          "explanation": "生成元可约束系数之间的关系。"
        },
        {
          "prompt": "投影后的系数是什么？",
          "hint": "这里没有实验拟合。",
          "choices": [
            "指定系数度量下的允许模型",
            "真实材料唯一参数",
            "精确实验能带"
          ],
          "answer": 0,
          "explanation": "这是明确表示空间和截断阶数下的教学投影。"
        }
      ]
    },
    {
      "id": "workshop-spin-exercise",
      "module": "workshop",
      "lesson": "workshop-spin",
      "title": "为什么反演加时间反演消除这里的自旋分裂：分步验证",
      "prompt": "先根据表示和生成元推导，再在工坊运行预设核对。",
      "steps": [
        {
          "prompt": "时间反演要求d(k)怎样变化？",
          "hint": "自旋在时间反演下反号。",
          "choices": [
            "奇函数",
            "偶函数",
            "不受限"
          ],
          "answer": 0,
          "explanation": "d(−k)=−d(k)。"
        },
        {
          "prompt": "同宇称双态中的反演要求d(k)怎样变化？",
          "hint": "自旋是轴向量。",
          "choices": [
            "奇函数",
            "偶函数",
            "只能有z分量"
          ],
          "answer": 1,
          "explanation": "反演不翻转自旋，故为偶函数。"
        },
        {
          "prompt": "两个条件合并得到什么？",
          "hint": "同时为奇和偶。",
          "choices": [
            "线性项加倍",
            "只在Γ为零",
            "处处为零"
          ],
          "answer": 2,
          "explanation": "此模型中d(k)=0，因此没有自旋分裂。"
        },
        {
          "prompt": "关闭镜面后能否仍声称保留完整原点群？",
          "hint": "剩余生成元才是约束依据。",
          "choices": [
            "不能，应列出剩余约束",
            "始终可以",
            "只看曲线即可"
          ],
          "answer": 0,
          "explanation": "生成元开关改变对称条件。"
        }
      ]
    },
    {
      "id": "workshop-breaking-exercise",
      "module": "workshop",
      "lesson": "workshop-breaking",
      "title": "用受控对照辨认磁性开隙：分步验证",
      "prompt": "先根据表示和生成元推导，再在工坊运行预设核对。",
      "steps": [
        {
          "prompt": "只有z旋转时常数mσ_z是否允许？",
          "hint": "σ_z与z旋转对易。",
          "choices": [
            "允许",
            "必定禁止",
            "依赖k_x"
          ],
          "answer": 0,
          "explanation": "z旋转保留轴向量z分量。"
        },
        {
          "prompt": "只启用时间反演后该常数项怎样？",
          "hint": "常数不能是k的奇函数。",
          "choices": [
            "加倍",
            "被禁止",
            "不变"
          ],
          "answer": 1,
          "explanation": "时间反演禁止该常数磁性项。"
        },
        {
          "prompt": "本模型Γ劈裂如何求？",
          "hint": "求2×2 Hermitian矩阵本征值。",
          "choices": [
            "|d_0|",
            "|m|/2",
            "2|d(0)|"
          ],
          "answer": 2,
          "explanation": "两条能量差是2|d|。"
        },
        {
          "prompt": "一条Γ附近开隙曲线能否给出材料Chern数？",
          "hint": "缺少完整布里渊区。",
          "choices": [
            "不能",
            "能，开隙就是1",
            "能，开隙就是0"
          ],
          "answer": 0,
          "explanation": "局部模型的开隙与全局拓扑诊断不同。"
        }
      ]
    }
