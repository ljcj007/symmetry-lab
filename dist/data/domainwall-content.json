          "choices": [
            "某个任意本征矢的每个分量",
            "Pᵢᵢ=Σ|ψₙ(i)|²",
            "每个波函数的正负号"
          ],
          "answer": 1,
          "explanation": "投影密度对选中子空间内部幺正换基不变。"
        }
      ]
    }
  ],
