&CONTROL
 calculation='scf',prefix='carbon',outdir='./out',pseudo_dir='../pseudo',verbosity='high',disk_io='low',max_seconds=1800,
/
&SYSTEM
 ibrav=0,nat=2,ntyp=1,ecutwfc=80,ecutrho=320,nbnd=12,occupations='fixed',
/
&ELECTRONS
 conv_thr=1d-11,electron_maxstep=120,mixing_beta=0.4,diagonalization='david',diago_full_acc=.true.,
/
ATOMIC_SPECIES
C 12.011 C.UPF
CELL_PARAMETERS angstrom
0 1.7835 1.7835
1.7835 0 1.7835
1.7835 1.7835 0
ATOMIC_POSITIONS crystal
C 0 0 0
C 0.25 0.25 0.25
K_POINTS automatic
4 4 4 0 0 0
