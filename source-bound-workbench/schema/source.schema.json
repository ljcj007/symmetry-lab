{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:source-bound:affine:v1",
  "title": "Complete exact real affine finite-source packet",
  "type": "object",
  "required": [
    "schema",
    "source",
    "request"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "source-bound-affine-v1"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "dimension",
        "parameters",
        "H0",
        "H_affine"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dimension": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "parameters": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          }
        },
        "H0": {
          "$ref": "#/$defs/matrix"
        },
        "H_affine": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/matrix"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "rank",
        "cuts",
        "Q_minus",
        "Q_plus"
      ],
      "additionalProperties": false,
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "cuts": {
          "type": "object",
          "required": [
            "lower",
            "upper"
          ],
          "additionalProperties": false,
          "properties": {
            "lower": {
              "$ref": "#/$defs/rational"
            },
            "upper": {
              "$ref": "#/$defs/rational"
            }
          }
        },
        "Q_minus": {
          "$ref": "#/$defs/matrix"
        },
        "Q_plus": {
          "$ref": "#/$defs/matrix"
        }
      }
    },
    "symmetry": {
      "type": "object",
      "required": [
        "V",
        "D"
      ],
      "additionalProperties": false,
      "properties": {
        "V": {
          "$ref": "#/$defs/matrix"
        },
        "D": {
          "$ref": "#/$defs/matrix"
        }
      }
    },
    "periodic_axes": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      }
    }
  },
  "$defs": {
    "rational": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]+)?|[0-9]+/[0-9]+)$"
        }
      ]
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "$ref": "#/$defs/rational"
        }
      }
    }
  },
  "$comment": "The receiver additionally checks exact matrix dimensions against n and rank, affine count against parameter count, denominator nonzero and rational bit limit, exact source symmetry, distinct in-range period axes, cut order and all mathematical identities. The source is always the complete n-row matrix; principal submatrix input cannot silently stand in for it."
}
