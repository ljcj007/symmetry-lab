&control
  calculation='nscf', restart_mode='from_scratch',
  prefix='Fe', pseudo_dir='./', outdir='./scratch',
  disk_io='low', verbosity='high', max_seconds=900,
/
&system
  ibrav=3, celldm(1)=5.4235, nat=1, ntyp=1,
  ecutwfc=120.0, ecutrho=480.0,
  lspinorb=.true., noncolin=.true., starting_magnetization(1)=-1,
  occupations='smearing', smearing='cold', degauss=0.02,
  nbnd=32, nosym=.true., noinv=.true.,
/
&electrons
  startingwfc='random', diagonalization='david',
  conv_thr=1.0e-10,
/
